    {
      "name": "07 - Manejo de errores",
      "item": [
        {
          "name": "Consultar una ruta inexistente (inválido)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/ruta-inexistente",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ruta-inexistente"]
            },
            "description": "Una ruta que no existe responde con el mismo sobre JSON que el resto de la API.\n\nSin el middleware correspondiente, Express devolvería una página HTML de error y cualquier cliente que espere JSON fallaría al interpretarla."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 404', function () {",
                  "  pm.response.to.have.status(404);",
                  "});",
                  "",
                  "pm.test('Responde en JSON, no en HTML', function () {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "  pm.expect(pm.response.json().message).to.eql('La ruta solicitada no existe');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Enviar un cuerpo JSON malformado (inválido)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ esto no es json valido",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/vehicles/entry",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "vehicles", "entry"]
            },
            "description": "Un cuerpo que no es JSON válido se responde como 400, no como 500: el error es del cliente, no del servidor."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 400 y no 500', function () {",
                  "  pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test('Señala que el cuerpo no es JSON válido', function () {",
                  "  pm.expect(pm.response.json().errors).to.include('El cuerpo de la petición no es un JSON válido');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
