          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 400', function () {",
                  "  pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test('Señala el formato de la placa', function () {",
                  "  pm.expect(pm.response.json().errors).to.include('La placa no tiene un formato válido');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "05 - Salida de vehículos",
      "item": [
        {
          "name": "Registrar salida anterior al ingreso (inválido)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plate\": \"{{plate}}\",\n  \"exitTime\": \"2020-01-01T00:00:00Z\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/vehicles/exit",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "vehicles", "exit"]
            },
            "description": "Regla de negocio 3: la hora de salida no puede ser anterior a la de entrada.\n\nDevuelve 422 y no 400 porque el dato es sintácticamente correcto: lo que falla es una regla del negocio, no el formato. La base de datos también lo impide con la restricción `valid_exit_time`."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 422', function () {",
                  "  pm.response.to.have.status(422);",
                  "});",
                  "",
                  "pm.test('Explica el conflicto de horas', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(false);",
                  "  pm.expect(body.message).to.eql('La hora de salida no puede ser anterior a la hora de entrada');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar salida (válido)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plate\": \"{{plate}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/vehicles/exit",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "vehicles", "exit"]
            },
            "description": "Cierra el ticket y calcula el cobro.\n\nCon el ingreso fijado noventa minutos atrás, la permanencia es de 1 h 30 min. Toda hora empezada se cobra completa, así que se facturan 2 horas: 10.000 pesos a la tarifa de automóvil."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Confirma la salida con el mensaje de la API', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.message).to.eql('Salida registrada correctamente');",
                  "});",
                  "",
                  "pm.test('El ticket queda cerrado', function () {",
                  "  pm.expect(pm.response.json().data.status).to.eql('CLOSED');",
                  "});",
                  "",
                  "pm.test('Cobra 2 horas por una permanencia de 90 minutos', function () {",
                  "  const data = pm.response.json().data;",
                  "  pm.expect(data.stayMinutes).to.eql(90);",
                  "  pm.expect(data.billing.stayDuration.hours).to.eql(1);",
                  "  pm.expect(data.billing.stayDuration.minutes).to.eql(30);",
                  "  pm.expect(data.billing.billableHours).to.eql(2);",
                  "  pm.expect(data.totalAmount).to.eql(10000);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar la misma salida otra vez (inválido)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plate\": \"{{plate}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/vehicles/exit",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "vehicles", "exit"]
            },
            "description": "Regla de negocio 4: no se puede registrar la salida de una placa que no está dentro.\n\nEs también la protección contra el cobro doble: la actualización lleva `AND status = 'ACTIVE'`, de modo que una segunda petición no coincide con ninguna fila."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 404', function () {",
                  "  pm.response.to.have.status(404);",
                  "});",
                  "",
                  "pm.test('No vuelve a cobrar el ticket', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(false);",
                  "  pm.expect(body.message).to.eql('No se encontró un vehículo activo con esta placa');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
